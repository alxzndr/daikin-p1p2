# Copy to tools/capture.env (git-ignored) and fill in. Loaded by tools/capture.sh
# for any P1P2_MQTT_* variable that is not already exported in your shell, so
# `P1P2_MQTT_HOST=... tools/capture.sh defrost` also works without this file.
#
# Never commit the filled-in file, never put real credentials in this example.
# Keep it to KEY=value lines: the file is sourced by a shell.

# MQTT broker that the bridge publishes to: the Mosquitto container on Unraid. It
# allows anonymous clients, so USER/PASS can stay empty there. (It bridges every
# topic to the Mosquitto on the HA host, 10.0.1.5, which does need a login.)
P1P2_MQTT_HOST=10.0.1.10
P1P2_MQTT_PORT=1883

# Broker user/password as configured in Mosquitto for a read-only subscriber.
# capture.sh passes these to mosquitto_sub on its command line, so they are
# visible in `ps` while the capture runs - do not use an admin account here.
P1P2_MQTT_USER=
P1P2_MQTT_PASS=

# Optional: MQTT client id (defaults to p1p2-capture-<pid>).
# P1P2_MQTT_CLIENT_ID=p1p2-capture

# Optional: only used by tools/capture.sh -D and by tools/scrub_capture.sh, to know
# which Home Assistant discovery topics belong to this bridge:
#   <prefix>/<component>/<node_id>/<object_id>/config
# The prefix is the discovery prefix configured on the bridge, the node id is the
# bridge name (both defaults match the firmware defaults and this house).
# P1P2_MQTT_HA_DISCOVERY_PREFIX=homeassistant
# P1P2_MQTT_HA_NODE_ID=bridge0
